<!-- Sort-order glyph for the Episodes screen: the classic swap-vert
     silhouette (up arrow left, down arrow right), composed from this
     app's own arrow_upward/arrow_downward paths so the stroke geometry
     matches the autoplay-direction arrows it sits beside. Groups scale
     the 960-viewport arrows to 55% and offset them into the two
     corners; VectorDrawable applies scale first, then translate. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960">
  <group
      android:scaleX="0.55"
      android:scaleY="0.55"
      android:translateX="-24"
      android:translateY="76">
    <path
        android:fillColor="@android:color/white"
        android:pathData="M440,800L440,313L216,537L160,480L480,160L800,480L744,537L520,313L520,800L440,800Z"/>
  </group>
  <group
      android:scaleX="0.55"
      android:scaleY="0.55"
      android:translateX="456"
      android:translateY="356">
    <path
        android:fillColor="@android:color/white"
        android:pathData="M440,160L440,647L216,423L160,480L480,800L800,480L744,423L520,647L520,160L440,160Z"/>
  </group>
</vector>
